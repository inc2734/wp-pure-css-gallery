{
  "engines": {
    "node": ">=24.22.1",
    "npm": ">=11.19.1"
  },
  "volta": {
    "node": "24.22.1"
  },
  "author": "inc2734",
  "license": "GPL-2.0+",
  "devDependencies": {
    "@wordpress/browserslist-config": "^7.0.0",
    "@wordpress/env": "^12.0.0",
    "autoprefixer": "^10.6.1",
    "npm-run-all": "^4.1.5",
    "rimraf": "^6.1.3",
    "cssnano": "^9.9.0",
    "sass": "^1.106.1",
    "postcss": "^8.5.31",
    "postcss-cli": "^12.0.0"
  },
  "scripts": {
    "wp-env": "wp-env",
    "start": "wp-env start",
    "stop": "wp-env stop",
    "destroy": "wp-env destroy && wp-env destroy --config=.wp-env.tests.json",
    "cli": "wp-env run cli",
    "wp": "wp-env run cli --env-cwd=\"wp-content/plugins/wp-pure-css-gallery\" wp",
    "composer": "wp-env run cli --env-cwd=\"wp-content/plugins/wp-pure-css-gallery\" composer",
    "test:php:start": "wp-env start --config=.wp-env.tests.json",
    "test:php:stop": "wp-env stop --config=.wp-env.tests.json",
    "test-composer": "wp-env run cli --config=.wp-env.tests.json --env-cwd=\"wp-content/plugins/wp-pure-css-gallery\" composer",
    "pretest:php:lint": "npm run test:php:start && npm run test-composer -- install --no-interaction",
    "test:php:lint": "wp-env run wordpress --config=.wp-env.tests.json --env-cwd=\"wp-content/plugins/wp-pure-css-gallery\" composer run-script lint",
    "posttest:php:lint": "npm run test:php:stop",
    "pretest:php:unit": "npm run test:php:start && npm run test-composer -- install --no-interaction",
    "test:php:unit": "wp-env run wordpress --config=.wp-env.tests.json --env-cwd=\"wp-content/plugins/wp-pure-css-gallery\" vendor/bin/phpunit -- -c .phpunit.xml.dist --verbose",
    "posttest:php:unit": "npm run test:php:stop",
    "test:lint:php": "npm run test:php:lint || (test_status=$?; npm run test:php:stop; exit $test_status)",
    "test:lint": "run-s test:lint:php",
    "test:unit:php": "npm run test:php:unit || (test_status=$?; npm run test:php:stop; exit $test_status)",
    "test:unit": "npm run test:unit:php",
    "test": "run-s test:lint test:unit",
    "cleanup:css": "rimraf src/assets/css && mkdir -p src/assets/css",
    "css:app": "sass --no-source-map src/src/css/wp-pure-css-gallery.scss src/assets/css/wp-pure-css-gallery.css && postcss -r src/assets/css/wp-pure-css-gallery.css -c=postcss.config.js",
    "css": "npm run cleanup:css && npm-run-all -s css:*",
    "build": "npm-run-all -p css"
  }
}
